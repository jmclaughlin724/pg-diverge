{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "supaschema configuration",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema pointer for editor autocomplete and validation. The loader ignores it.",
      "examples": [
        "./node_modules/supaschema/supaschema-config.schema.json",
        "./supaschema-config.schema.json"
      ]
    },
    "adapter": {
      "default": "auto",
      "type": "string",
      "enum": [
        "auto"
      ],
      "description": "Provider-neutral adapter sentinel."
    },
    "cascade": {
      "default": "never",
      "type": "string",
      "const": "never",
      "description": "CASCADE is never emitted by generated migrations."
    },
    "destructiveChanges": {
      "default": "hint-required",
      "type": "string",
      "enum": [
        "hint-required",
        "block",
        "allow"
      ],
      "description": "Controls whether destructive operations require exact hints, always block, or are allowed."
    },
    "environments": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "databaseUrl": {
            "type": "string"
          }
        },
        "required": [
          "databaseUrl"
        ],
        "additionalProperties": false
      },
      "description": "Named database URL references used by --env. Store credentials in environment variables.",
      "examples": [
        {},
        {
          "staging": {
            "databaseUrl": "$STAGING_DB"
          }
        }
      ]
    },
    "excludedGrantRoles": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Grant/default-privilege roles to remove from extracted models, usually provider platform roles."
    },
    "hints": {
      "default": {
        "allowedGrantees": [],
        "destructive": [],
        "requiredPolicyColumns": {},
        "renames": []
      },
      "type": "object",
      "properties": {
        "allowedGrantees": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "destructive": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requiredPolicyColumns": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "renames": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Reviewed grant, RLS policy-column, destructive-change, and rename hints using exact object keys, table keys, or role names."
    },
    "idempotency": {
      "default": "required",
      "type": "string",
      "const": "required",
      "description": "Generated SQL must be replay-safe by construction."
    },
    "lockTimeout": {
      "default": "5s",
      "type": "string",
      "description": "Migration preamble SET lock_timeout value."
    },
    "workflow": {
      "default": {
        "schema_diff": "on_schema_write",
        "migration_check": "after_schema_diff",
        "migration_verify": "suggest_after_check",
        "migration_sync": "auto",
        "type_safety": "report_only",
        "rls_safety": "report_only",
        "type_generation": "create_or_refresh",
        "zod_generation": "create_or_refresh",
        "type_usage": "zod_validated"
      },
      "type": "object",
      "properties": {
        "schema_diff": {
          "default": "on_schema_write",
          "type": "string",
          "enum": [
            "disabled",
            "manual",
            "on_schema_write"
          ],
          "description": "Controls whether agent hooks generate a schema migration automatically after configured schema-tree SQL writes."
        },
        "migration_check": {
          "default": "after_schema_diff",
          "type": "string",
          "enum": [
            "manual",
            "after_schema_diff",
            "required_before_complete"
          ],
          "description": "Controls when replay-safety checks run after a generated migration."
        },
        "migration_verify": {
          "default": "suggest_after_check",
          "type": "string",
          "enum": [
            "manual",
            "suggest_after_check",
            "after_schema_diff"
          ],
          "description": "Controls whether agents should only suggest verification or run it automatically when a database is available."
        },
        "migration_sync": {
          "default": "auto",
          "type": "string",
          "enum": [
            "disabled",
            "manual",
            "auto"
          ],
          "description": "Global apply policy for supaschema sync: disable apply, require explicit --target, or let bare sync select one sync.targets entry whose mode is \"auto\"."
        },
        "type_safety": {
          "default": "report_only",
          "type": "string",
          "enum": [
            "disabled",
            "report_only",
            "deploy_blocking"
          ],
          "description": "Controls whether sync type-contract diagnostics are disabled, reported only, or block deploy."
        },
        "rls_safety": {
          "default": "report_only",
          "type": "string",
          "enum": [
            "disabled",
            "report_only",
            "deploy_blocking"
          ],
          "description": "Controls whether sync RLS and least-privilege diagnostics are disabled, reported only, or block deploy."
        },
        "type_generation": {
          "default": "create_or_refresh",
          "type": "string",
          "enum": [
            "disabled",
            "refresh_existing",
            "create_or_refresh"
          ],
          "description": "Controls whether sync refreshes the configured TypeScript output during the full workflow."
        },
        "zod_generation": {
          "default": "create_or_refresh",
          "type": "string",
          "enum": [
            "disabled",
            "refresh_existing",
            "create_or_refresh"
          ],
          "description": "Controls whether sync refreshes the configured Zod validator output during the full workflow."
        },
        "type_usage": {
          "default": "zod_validated",
          "type": "string",
          "enum": [
            "typescript_only",
            "zod_validated"
          ],
          "description": "Controls whether agents should prefer generated Zod validators or TypeScript-only generated shapes when wiring application code."
        }
      },
      "additionalProperties": false,
      "description": "Automation policy for hooks, generated contract guidance, verification guidance, deploy safety gates, and whether bare sync may select one apply target."
    },
    "sync": {
      "default": {
        "targets": {
          "local": {
            "mode": "auto",
            "runner": "direct",
            "historyTable": "supabase_migrations.schema_migrations"
          },
          "remote": {
            "mode": "manual",
            "runner": "direct",
            "historyTable": "supabase_migrations.schema_migrations",
            "requireApprovalEnv": "SUPASCHEMA_REMOTE_SYNC_APPROVED",
            "remote": true
          }
        }
      },
      "type": "object",
      "properties": {
        "targets": {
          "default": {
            "local": {
              "mode": "auto",
              "runner": "direct",
              "historyTable": "supabase_migrations.schema_migrations"
            },
            "remote": {
              "mode": "manual",
              "runner": "direct",
              "historyTable": "supabase_migrations.schema_migrations",
              "requireApprovalEnv": "SUPASCHEMA_REMOTE_SYNC_APPROVED",
              "remote": true
            }
          },
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "historyTable": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "manual",
                  "auto"
                ]
              },
              "remote": {
                "type": "boolean"
              },
              "requireApprovalEnv": {
                "type": "string"
              },
              "runner": {
                "type": "string",
                "enum": [
                  "direct",
                  "supabase-cli"
                ]
              },
              "databaseUrl": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "required": [
              "historyTable",
              "mode",
              "runner"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "description": "Named apply targets for supaschema sync. workflow.migration_sync is the global apply policy; bare sync may select at most one target with mode auto.",
      "examples": [
        {
          "targets": {
            "local": {
              "mode": "auto",
              "runner": "direct",
              "historyTable": "supabase_migrations.schema_migrations"
            },
            "remote": {
              "mode": "manual",
              "runner": "direct",
              "historyTable": "supabase_migrations.schema_migrations",
              "requireApprovalEnv": "SUPASCHEMA_REMOTE_SYNC_APPROVED",
              "remote": true
            }
          }
        }
      ]
    },
    "migrationsDir": {
      "default": "database/migrations",
      "type": "string",
      "description": "Directory where diff writes migrations, check/verify read pending migrations, and planning reads existing migrations for source intent plus generated-lineage baseline proof.",
      "examples": [
        "database/migrations",
        "supabase/migrations",
        "neon/migrations",
        "aws-postgresql/migrations"
      ],
      "x-supaschema-path-kind": "directory"
    },
    "typesFile": {
      "default": "database.types.ts",
      "type": "string",
      "description": "Output file for TypeScript database types generated by supaschema types.",
      "x-supaschema-path-kind": "file"
    },
    "zodFile": {
      "default": "database.zod.ts",
      "type": "string",
      "description": "Output file for Zod runtime schemas generated by supaschema types.",
      "x-supaschema-path-kind": "file"
    },
    "zodTypesImportPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "Optional module specifier for the generated Zod file's type-only Database and Json import.",
      "examples": [
        "@acme/db/types"
      ]
    },
    "normalize": {
      "default": "deparse",
      "type": "string",
      "enum": [
        "off",
        "deparse"
      ],
      "description": "Controls canonical SQL deparse normalization for extracted objects."
    },
    "managedSchemas": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Externally owned schemas blocked from declarative ownership. Supabase installs seed the Supabase platform schema list.",
      "examples": [
        [],
        [
          "auth",
          "storage",
          "realtime",
          "vault",
          "extensions",
          "cron",
          "net",
          "supabase_functions",
          "graphql",
          "graphql_public"
        ]
      ]
    },
    "managedSchemaOverlays": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Exact policy, grant, or comment object keys that Supaschema may manage inside managed schemas. Wildcards and structural objects are not supported.",
      "examples": [
        [
          "policy:storage.tenant_document_read:objects"
        ]
      ]
    },
    "postgresVersion": {
      "default": "15+",
      "type": "string",
      "description": "Documented supported PostgreSQL syntax floor."
    },
    "renameDetection": {
      "default": "hints-only",
      "type": "string",
      "enum": [
        "hints-only",
        "off"
      ],
      "description": "Controls whether reviewed hints can render guarded renames."
    },
    "schemaPaths": {
      "default": [
        "database/schemas"
      ],
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Declarative SQL tree roots. Each root is read recursively; the first path is the zero-argument command target.",
      "examples": [
        [
          "database/schemas"
        ],
        [
          "supabase/schemas"
        ],
        [
          "neon/schemas"
        ],
        [
          "aws-postgresql/schemas"
        ]
      ],
      "x-supaschema-path-kind": "directory-list"
    },
    "schemas": {
      "default": {
        "exclude": [],
        "include": []
      },
      "type": "object",
      "properties": {
        "exclude": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "include": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "Persistent schema include/exclude filters applied to extracted models."
    },
    "sources": {
      "default": {
        "from": "auto"
      },
      "type": "object",
      "properties": {
        "from": {
          "default": "auto",
          "description": "Default before-state source. For generation, \"auto\" uses a proven git:INDEX closure, replays migrations:<migrationsDir> for adoption or a hand-authored tail, uses git:HEAD only for contiguous lineage, and uses empty: only when no migration corpus exists.",
          "examples": [
            "auto",
            "git:HEAD",
            "empty:",
            "dir:baseline/schemas",
            "migrations:supabase/migrations",
            "database:$DATABASE_URL"
          ],
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "string",
              "not": {
                "const": "auto"
              },
              "x-supaschema-source-parser": "parseRuntimeSource"
            }
          ]
        }
      },
      "additionalProperties": false,
      "description": "Default before source for zero-source-flag diff, plan, and verify. For generation, sources.from:auto uses a proven staged closure, replays the configured migration corpus for adoption or a manual tail, and uses git:HEAD only for contiguous lineage.",
      "examples": [
        {
          "from": "auto"
        },
        {
          "from": "dir:baseline/schemas"
        }
      ]
    },
    "statementTimeout": {
      "default": "60s",
      "type": "string",
      "description": "Migration preamble SET statement_timeout value."
    },
    "transactionMode": {
      "default": "per-migration",
      "type": "string",
      "enum": [
        "per-migration",
        "per-statement"
      ],
      "description": "Transaction model used by verification and transaction-hazard diagnostics."
    },
    "validators": {
      "default": [
        "internal-parser"
      ],
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Configured external validator commands. The internal parser always remains the correctness owner.",
      "examples": [
        [
          "internal-parser"
        ],
        [
          "internal-parser",
          "squawk"
        ]
      ]
    }
  },
  "additionalProperties": false,
  "$id": "https://supaschema.com/schemas/supaschema-config.schema.json",
  "description": "Machine-readable supaschema.config.json contract. The public field reference is docs/configuration/config-file.mdx."
}
