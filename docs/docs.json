{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "supaschema",
  "description": "From declarative PostgreSQL schema to replay-safe migrations, generated types, Zod validators, and guarded sync in seconds. No ORM schema layer, no Docker, no shadow database.",
  "logo": {
    "light": "/images/brand/supaschema-logo-light.png",
    "dark": "/images/brand/supaschema-logo-dark.png",
    "href": "https://supaschema.com/docs"
  },
