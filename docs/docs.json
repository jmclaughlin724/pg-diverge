    "primary": "#A91616",
    "light": "#FACC15",
    "dark": "#C2410C"
  },
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "metadata": {
    "timestamp": true
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/images/brand/mintlify-og-background.png"
  },
