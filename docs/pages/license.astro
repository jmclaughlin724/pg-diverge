---
import data from "blume:data";
import PageLayout from "blume/components/layout/PageLayout.astro";

const pageTitle = "Retrieve your Supaschema license";
const pageDescription =
  "Retrieve the repository-bound Supaschema license created by your completed checkout.";
---

<PageLayout
  appleIcon={data.config.appleIcon}
  askEnabled={Boolean(data.config.ask)}
  banner={data.config.banner}
  favicon={data.config.favicon}
  fontCssVars={data.fontCssVars}
  logo={data.config.logo}
  navigation={data.navigation}
  noindex
  page={{ description: pageDescription, route: "/license", title: pageTitle }}
  searchEnabled={data.config.search.enabled}
  site={{ description: data.config.description, title: data.config.title }}
  themeMode={data.config.theme.mode}
  ui={data.ui}
>
  <section
    class="mx-auto flex min-h-[65vh] w-full max-w-3xl items-center px-6 py-16"
    data-license-delivery
  >
    <div
      class="w-full rounded-xl border border-border bg-card p-6 shadow-sm sm:p-8"
    >
      <h1
        class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
      >
        Retrieve your license
      </h1>
      <p class="mt-3 text-muted-foreground">
        Keep this page open while Stripe confirms your payment. Your
        repository-bound token appears here as soon as the checkout webhook
        finishes.
      </p>

      <p
        class="mt-6 text-sm text-muted-foreground"
        data-license-status
        role="status"
      >
        Retrieving your license…
      </p>

      <div class="mt-6" data-license-token-panel hidden>
        <label class="text-sm font-medium text-foreground" for="license-token">
          License token
        </label>
        <textarea
          aria-describedby="license-storage-guidance"
          class="mt-2 min-h-40 w-full resize-y rounded-md border border-border bg-muted p-3 font-mono text-xs text-foreground"
          id="license-token"
          readonly
          spellcheck="false"></textarea>
        <p
          class="mt-2 text-sm text-muted-foreground"
          id="license-storage-guidance"
        >
          Store this token as a secret. Do not commit it to your repository or
          paste it into an issue.
        </p>
        <button
          class="mt-4 rounded-md bg-accent px-4 py-2 text-sm font-medium text-accent-foreground hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          data-copy-license
          type="button"
        >
          Copy license token
        </button>
      </div>

      <button
        class="mt-4 rounded-md border border-border px-4 py-2 text-sm font-medium text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        data-retry-license
        hidden
        type="button"
      >
        Try again
      </button>
    </div>
  </section>
</PageLayout>

<script>
  const LICENSE_ENDPOINT = "https://license.supaschema.com/license";
  const MAX_PENDING_ATTEMPTS = 30;
  const PENDING_RETRY_MS = 2000;
  const REQUEST_TIMEOUT_MS = 10_000;

  const root = document.querySelector<HTMLElement>("[data-license-delivery]");
  const status = root?.querySelector<HTMLElement>("[data-license-status]");
  const tokenPanel = root?.querySelector<HTMLElement>(
    "[data-license-token-panel]"
  );
  const token = root?.querySelector<HTMLTextAreaElement>("#license-token");
  const copyButton = root?.querySelector<HTMLButtonElement>(
    "[data-copy-license]"
  );
  const retryButton = root?.querySelector<HTMLButtonElement>(
    "[data-retry-license]"
  );

  if (!(root && status && tokenPanel && token && copyButton && retryButton)) {
    throw new Error("license delivery page is missing required elements");
  }

  const currentUrl = new URL(window.location.href);
  const sessionIdParameter = currentUrl.searchParams.get("session_id");
  const sessionId = sessionIdParameter?.trim();
  if (sessionIdParameter !== null) {
    currentUrl.searchParams.delete("session_id");
    window.history.replaceState(
      window.history.state,
      "",
      `${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`
    );
  }
  let pendingAttempts = 0;
  let requestInFlight = false;

  const isRecord = (value: unknown): value is Record<string, unknown> =>
    typeof value === "object" && value !== null && !Array.isArray(value);

  const responseRecord = (value: unknown): Record<string, unknown> | null =>
    isRecord(value) ? value : null;

  const readResponse = async (
    response: Response
  ): Promise<Record<string, unknown> | null> => {
    try {
      return responseRecord(await response.json());
    } catch {
      return null;
    }
  };

  const showRetry = (message: string): void => {
    status.textContent = message;
    retryButton.hidden = false;
  };

  const retrieveLicense = async (resetAttempts = false): Promise<void> => {
    if (!sessionId || requestInFlight) {
      return;
    }
    if (resetAttempts) {
      pendingAttempts = 0;
    }
    requestInFlight = true;
    retryButton.hidden = true;
    status.textContent = "Retrieving your license…";

    const endpoint = new URL(LICENSE_ENDPOINT);
    endpoint.searchParams.set("session_id", sessionId);
    const abortController = new AbortController();
    const timeoutId = window.setTimeout(() => {
      abortController.abort();
    }, REQUEST_TIMEOUT_MS);
    try {
      const response = await fetch(endpoint, {
        cache: "no-store",
        credentials: "omit",
        headers: { accept: "application/json" },
        referrerPolicy: "no-referrer",
        signal: abortController.signal,
      });
      if (response.status === 404) {
        const pendingBody = await readResponse(response);
        if (pendingBody?.pending === true) {
          pendingAttempts += 1;
          if (pendingAttempts >= MAX_PENDING_ATTEMPTS) {
            showRetry(
              "Your license is still being prepared. Wait a moment, then try again."
            );
            return;
          }
          status.textContent =
            "Checkout complete. Your license is still being prepared…";
          window.setTimeout(async () => {
            await retrieveLicense();
          }, PENDING_RETRY_MS);
          return;
        }
        showRetry("We could not retrieve your license. Try again in a moment.");
        return;
      }
      if (!response.ok) {
        showRetry("We could not retrieve your license. Try again in a moment.");
        return;
      }
      const body = await readResponse(response);
      if (typeof body?.license !== "string" || body.license.length === 0) {
        showRetry(
          "The license service returned an invalid response. Try again in a moment."
        );
        return;
      }

      token.value = body.license;
      tokenPanel.hidden = false;
      status.textContent = "Your license is ready.";
    } catch (error) {
      if (error instanceof DOMException && error.name === "AbortError") {
        showRetry(
          "The license service timed out. Check your connection and try again."
        );
      } else {
        showRetry(
          "The license service is unavailable. Check your connection and try again."
        );
      }
    } finally {
      window.clearTimeout(timeoutId);
      requestInFlight = false;
    }
  };

  copyButton.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(token.value);
      copyButton.textContent = "Copied";
      status.textContent = "License token copied to your clipboard.";
    } catch {
      token.focus();
      token.select();
      status.textContent = "Select and copy the license token manually.";
    }
  });

  retryButton.addEventListener("click", async () => {
    await retrieveLicense(true);
  });

  if (sessionId) {
    await retrieveLicense();
  } else {
    showRetry(
      "This checkout link is missing its Stripe session id. Return to checkout and try again."
    );
    retryButton.hidden = true;
  }
</script>
