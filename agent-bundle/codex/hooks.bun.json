{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|exec_command|functions\\.exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/general-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking general Bash safety policy"
          }
        ]
      },
      {
        "matcher": "^(apply_patch|functions\\.apply_patch|Edit|Write|edit_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "bunx --no-install supaschema hook generated-migration-edit --runtime codex",
            "timeout": 10,
            "statusMessage": "Checking supaschema generated-migration policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|functions\\.apply_patch|Edit|Write|edit_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "bunx --no-install supaschema hook schema-write",
            "timeout": 130,
            "statusMessage": "Running supaschema auto-diff on schema change"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/sync-llm-on-claude-surface-change.mjs\"",
            "timeout": 130,
            "statusMessage": "Syncing supaschema Claude agent surfaces"
          }
        ]
      }
    ]
  }
}
