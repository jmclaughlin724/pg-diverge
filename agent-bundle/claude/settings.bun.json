{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guards/bash-policy-checks.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "\"${CLAUDE_PROJECT_DIR}/node_modules/.bin/supaschema\" \"$@\"",
              "supaschema",
              "hook",
              "generated-migration-edit",
              "--runtime",
              "claude"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "sh",
            "args": [
              "-c",
              "\"${CLAUDE_PROJECT_DIR}/node_modules/.bin/supaschema\" \"$@\"",
              "supaschema",
              "hook",
              "schema-write"
            ],
            "timeout": 130
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-llm-on-claude-surface-change.mjs\"",
            "timeout": 130
          }
        ]
      }
    ]
  }
}
