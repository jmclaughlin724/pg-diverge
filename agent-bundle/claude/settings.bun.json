{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "args": [
              "hook",
              "schema-write"
            ],
            "command": "./node_modules/.bin/supaschema",
            "statusMessage": "Running supaschema auto-diff on schema change",
            "timeout": 130,
            "type": "command"
          }
        ],
        "matcher": "Bash|Write|Edit|MultiEdit|apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guards/bash-policy-checks.mjs\"",
            "statusMessage": "Checking general Bash safety policy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "args": [
              "hook",
              "generated-migration-edit",
              "--runtime",
              "claude"
            ],
            "command": "./node_modules/.bin/supaschema",
            "statusMessage": "Checking supaschema generated-migration policy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch"
      }
    ]
  }
}
