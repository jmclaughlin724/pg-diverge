{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "yarn exec supaschema hook schema-write",
            "statusMessage": "Running supaschema auto-diff on schema change",
            "timeout": 130,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "yarn exec supaschema hook generated-migration-edit --runtime claude",
            "statusMessage": "Checking supaschema generated-migration policy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch"
      }
    ]
  }
}
