{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "pnpm exec supaschema hook schema-write",
            "statusMessage": "Running supaschema auto-diff on schema change",
            "timeout": 130,
            "type": "command"
          }
        ],
        "matcher": "Bash|Write|Edit|MultiEdit|apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guards/bash-policy-checks.mjs"
            ],
            "command": "node",
            "statusMessage": "Checking general Bash safety policy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "pnpm exec supaschema hook generated-migration-edit --runtime claude",
            "statusMessage": "Checking supaschema generated-migration policy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit|apply_patch"
      }
    ]
  }
}
