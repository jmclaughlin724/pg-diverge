{
  "mode": "warn",
  "rules": [
    {
      "skill": "code-atlas",
      "whenPathGlob": [
        "src/**",
        "scripts/code-atlas/**",
        "scripts/guards/**",
        "cloudflare/**",
        "wrangler.toml",
        ".github/workflows/**"
      ],
      "reason": "Structural source, deploy, or graph-sensitive edits should be mapped first."
    },
    {
      "skill": "fastmcp",
      "whenPathGlob": [
        "services/agent-mcp/**",
        "fastmcp.json",
        ".mcp.json",
        ".codex/config.toml"
      ],
      "reason": "Repo-context MCP changes must preserve read-only path security and fixed Code Atlas access."
    },
    {
      "skill": "upstream",
      "whenPathGlob": ["docs/**", "package.json", "pyproject.toml"],
      "reason": "External docs, package, and framework facts should be verified upstream."
    }
  ]
}
