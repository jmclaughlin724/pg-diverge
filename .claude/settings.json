{
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "cloudflare-api",
    "cloudflare-docs",
    "supaschema",
    "context7",
    "mintlify",
    "openaiDeveloperDocs",
    "ultracite",
    "zod",
    "supaschema-docs"
  ],
  "disabledMcpjsonServers": ["stripe"],
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-session-start.mjs"
            ],
            "statusMessage": "Loading supaschema agent context",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-user-prompt-submit.mjs"
            ],
            "statusMessage": "Checking prompt-scoped supaschema context",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-pre-tool-use.mjs"
            ],
            "statusMessage": "Checking required supaschema context",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/supaschema-source-hook.mjs",
              "hook",
              "generated-migration-edit",
              "--runtime",
              "claude"
            ],
            "statusMessage": "Checking supaschema generated-migration policy",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Bash|Edit|MultiEdit|NotebookEdit|Read|Skill|Task|Write|apply_patch|mcp__supaschema__code_atlas_query",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-post-tool-use.mjs"
            ],
            "statusMessage": "Recording supaschema hook evidence",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/supaschema-source-hook.mjs",
              "hook",
              "schema-write"
            ],
            "statusMessage": "Running supaschema auto-diff on schema change",
            "timeout": 130
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-llm-on-claude-surface-change.mjs"
            ],
            "statusMessage": "Syncing supaschema Claude agent surfaces",
            "timeout": 130
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Bash|Edit|MultiEdit|NotebookEdit|Read|Skill|Task|Write|apply_patch|mcp__supaschema__code_atlas_query",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-post-tool-use-failure.mjs"
            ],
            "statusMessage": "Recording failed supaschema hook evidence",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/sync-llm-on-claude-surface-change.mjs"
            ],
            "statusMessage": "Syncing supaschema Claude agent surfaces",
            "timeout": 130
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-subagent-start.mjs"
            ],
            "statusMessage": "Loading supaschema subagent context",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/context-stop.mjs"],
            "statusMessage": "Checking supaschema final-response evidence",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-subagent-stop.mjs"
            ],
            "statusMessage": "Checking supaschema subagent closeout",
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-task-completed.mjs"
            ],
            "statusMessage": "Checking supaschema task completion",
            "timeout": 10
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-worktree-create.mjs"
            ],
            "statusMessage": "Blocking prohibited worktree creation",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-session-end.mjs"
            ],
            "statusMessage": "Clearing supaschema agent hook state",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
