{
  "servers": [
    {
      "extensions": ["py", "pyi"],
      "command": ["uv", "run", "pylsp"],
      "rootDir": ".",
      "initializationOptions": {
        "settings": {
          "pylsp": {
            "plugins": {
              "ruff": {
                "enabled": true,
                "formatEnabled": false,
                "lineLength": 100,
                "extendIgnore": ["E501", "E203"]
              },
              "black": { "enabled": true, "line_length": 100 },
              "isort": { "enabled": true },
              "pylsp_rope": { "enabled": true, "rename": true },
              "pyls_memestra": { "enabled": true },
              "pycodestyle": { "enabled": false },
              "pyflakes": { "enabled": false },
              "mccabe": { "enabled": false },
              "autopep8": { "enabled": false },
              "yapf": { "enabled": false },
              "flake8": { "enabled": false },
              "pylint": { "enabled": false },
              "pydocstyle": { "enabled": false }
            }
          }
        }
      }
    },
    {
      "extensions": ["ts", "tsx", "js", "jsx", "mjs", "cjs"],
      "command": [
        "node",
        "scripts/cclsp-language-id-proxy.mjs",
        "--",
        "npx",
        "--yes",
        "--package",
        "typescript-language-server@5.3.0",
        "typescript-language-server",
        "--stdio"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["sql"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "@postgres-language-server/cli@0.25.3",
        "postgres-language-server",
        "lsp-proxy"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["json", "jsonc"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "vscode-langservers-extracted@4.10.0",
        "vscode-json-language-server",
        "--stdio"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["css", "scss", "less"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "vscode-langservers-extracted@4.10.0",
        "vscode-css-language-server",
        "--stdio"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["html"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "vscode-langservers-extracted@4.10.0",
        "vscode-html-language-server",
        "--stdio"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["yaml", "yml"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "yaml-language-server@1.23.0",
        "yaml-language-server",
        "--stdio"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["sh", "bash"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "bash-language-server@5.6.0",
        "bash-language-server",
        "start"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["toml"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "@taplo/cli@0.7.0",
        "taplo",
        "lsp",
        "stdio"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["md", "markdown", "mdx", "rules"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "vscode-langservers-extracted@4.10.0",
        "vscode-markdown-language-server",
        "--stdio"
      ],
      "rootDir": "."
    },
    {
      "extensions": ["dockerfile"],
      "command": [
        "npx",
        "--yes",
        "--package",
        "dockerfile-language-server-nodejs@0.15.0",
        "docker-langserver",
        "--stdio"
      ],
      "rootDir": "."
    }
  ]
}
