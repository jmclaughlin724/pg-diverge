{
  "name": "supaschema",
  "version": "0.2.0",
  "description": "Declarative PostgreSQL schema migrations plus TypeScript and Zod types in milliseconds — Supabase-aware, built on PostgreSQL's own parser, with no Docker or shadow database.",
  "type": "module",
  "sideEffects": false,
  "license": "AGPL-3.0-only",
  "author": "John McLaughlin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmclaughlin724/supaschema.git"
  },
  "bugs": {
    "url": "https://github.com/jmclaughlin724/supaschema/issues"
  },
  "homepage": "https://supaschema.com/docs",
  "bin": {
    "supaschema": "bin/supaschema"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    ".agents/skills/supaschema",
    ".claude/hooks/auto-diff-on-schema-change.mjs",
    ".claude/hooks/block-generated-migration-edits.mjs",
    ".claude/rules/supaschema.md",
    ".claude/skills/supaschema",
    ".codex/hooks/auto-diff-on-schema-change.mjs",
    ".codex/hooks/supaschema-tool-gate.mjs",
    ".codex/hooks.json",
    ".codex/rules/supaschema.rules",
    ".codex/skills/supaschema",
    "benchmarks/README.md",
    "benchmarks/compare.js",
    "benchmarks/fixtures",
    "benchmarks/plot-concepts.js",
    "benchmarks/plot-head-to-head.js",
    "benchmarks/plot-lib.js",
    "benchmarks/plot-svg.js",
    "benchmarks/plot.js",
    "benchmarks/tools",
    "bin",
    "config-schema.json",
    "corpus",
    "dist",
    "docs",
    "examples",
    "LICENSE",
    "LICENSE-COMMERCIAL.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "benchmark": "npm run build && node dist/benchmark.js",
    "bench:compare": "npm run build && node benchmarks/compare.js",
    "bench:plot": "node benchmarks/plot.js",
    "bench:plot:headtohead": "node benchmarks/plot-head-to-head.js benchmarks/results/comparison-xl.json docs/images/benchmarks/head-to-head-xl.svg && node benchmarks/plot-head-to-head.js benchmarks/results/comparison-xxl.json docs/images/benchmarks/head-to-head-xxl.svg && node benchmarks/plot-head-to-head.js --workflow benchmarks/results/comparison-xl.json docs/images/benchmarks/head-to-head-workflow-xl.svg",
    "bench:plot:docs": "node benchmarks/plot.js benchmarks/results/comparison.json benchmarks/results/comparison-realistic.json benchmarks/results/comparison-xl.json benchmarks/results/comparison-xxl.json --charts-dir docs/images/benchmarks && npm run bench:plot:headtohead",
    "diagrams": "node benchmarks/plot-concepts.js",
    "build": "tsc -p tsconfig.src.json && node dist/config-schema-gen.js",
    "check": "npm run lint && npm test && npm run build",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:schema": "node scripts/check-schema.mjs",
    "clean": "rm -rf dist coverage .tmp api-docs benchmarks/results .wrangler/tmp",
    "code-atlas:build": "node scripts/code-atlas/build.mjs",
    "code-atlas:query": "node scripts/code-atlas/query.mjs",
    "code-atlas:check": "node scripts/guards/check-code-atlas.mjs",
    "code-atlas:mcp": "node scripts/code-atlas/mcp-wrapper.mjs",
    "code-atlas:mcp:status": "node scripts/code-atlas/mcp-wrapper.mjs --status",
    "docs:lint": "node scripts/check-docs-standard.mjs",
    "docs:check": "npm run docs:lint && cd docs && npx --yes mint@4.2.616 validate && npx --yes mint@4.2.616 broken-links --check-anchors && npx --yes mint@4.2.616 a11y",
    "docs:dev": "cd docs && npx --yes mint@4.2.616 dev --no-open",
    "corpus:check": "npm run build && node dist/cli.js corpus --corpus-dir corpus/supabase-style",
    "fixture:diff": "node dist/cli.js diff --from dir:tests/fixtures/basic/from --to dir:tests/fixtures/basic/to --out stdout",
    "fixture:verify": "npm run build && out=$(mktemp -d)/basic.sql && node dist/cli.js diff --from dir:tests/fixtures/basic/from --to dir:tests/fixtures/basic/to --out \"$out\" && node dist/cli.js verify --from dir:tests/fixtures/basic/from --to dir:tests/fixtures/basic/to --migration \"$out\"",
    "format": "ultracite fix .",
    "catalog:check": "node scripts/guards/check-dependency-catalog.mjs",
    "fastmcp:inspect": "uv run --package supaschema-agent-mcp fastmcp inspect fastmcp.json",
    "fastmcp:list": "uv run --package supaschema-agent-mcp fastmcp list services/agent-mcp/supaschema_agent_mcp/server.py --resources --prompts",
    "fastmcp:status": "uv run --package supaschema-agent-mcp fastmcp call services/agent-mcp/supaschema_agent_mcp/server.py server_status --json",
    "guard": "node scripts/guards/check-all.mjs",
    "guard:agent": "node scripts/guards/check-agent-hooks.mjs && node scripts/guards/check-agent-surface-parity.mjs",
    "guard:catalog": "npm run catalog:check",
    "guard:code-atlas": "npm run code-atlas:check",
    "guard:fastmcp": "node scripts/guards/check-fastmcp-agent.mjs",
    "guard:lsp-coverage": "node scripts/guards/check-lsp-coverage.mjs",
    "lint": "ultracite check .",
    "lint:ci": "biome ci .",
    "lint:doctor": "ultracite doctor",
    "lint:fix": "ultracite fix .",
    "pack:dry": "npm pack --dry-run",
    "postinstall": "node bin/postinstall.mjs",
    "prepare": "npm run build && node scripts/install-hooks.mjs",
    "changeset": "changeset",
    "release:version": "changeset version",
    "py:lint": "uv run --package supaschema-agent-mcp ruff check services/agent-mcp",
    "py:format:check": "uv run --package supaschema-agent-mcp ruff format --check services/agent-mcp",
    "py:typecheck": "uv run --package supaschema-agent-mcp mypy services/agent-mcp/supaschema_agent_mcp",
    "py:test": "uv run --package supaschema-agent-mcp pytest services/agent-mcp/tests",
    "test": "vitest run",
    "sync:llm": "node scripts/skills/sync-llm.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.tools.json --noEmit"
  },
  "keywords": [
    "database-migrations",
    "declarative-database",
    "declarative-schema",
    "idempotent-migrations",
    "postgres-migrations",
    "postgres",
    "postgresql",
    "rls",
    "schema-diff",
    "supabase",
    "supabase-migrations",
    "migration",
    "schema",
    "diff",
    "sql",
    "typescript-types",
    "zod"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "libpg-query": "^17.7.3",
    "pg": "^8.21.0",
    "pgsql-deparser": "^17.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "2.5.0",
    "@changesets/cli": "^2.31.0",
    "@postgres-language-server/cli": "0.25.3",
    "@taplo/cli": "0.7.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "4.1.8",
    "bash-language-server": "5.6.0",
    "dockerfile-language-server-nodejs": "0.15.0",
    "fast-check": "^4.8.0",
    "lefthook": "^2.1.9",
    "mdast-util-to-string": "^4.0.0",
    "publint": "^0.3.21",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "typescript-language-server": "5.3.0",
    "ultracite": "7.8.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "4.1.8",
    "vscode-langservers-extracted": "4.10.0",
    "yaml": "^2.9.0",
    "yaml-language-server": "1.23.0"
  },
  "overrides": {
    "minimatch": "10.2.5"
  }
}
