{
  "name": "supaschema",
  "version": "0.3.2",
  "description": "Declarative PostgreSQL schema management for replay-safe migrations, guarded sync, TypeScript types, and Zod validators without an ORM, Docker, or a shadow database.",
  "keywords": [
    "ai-coding-agents",
    "database-migrations",
    "declarative-database",
    "declarative-schema",
    "drift-detection",
    "idempotent-migrations",
    "postgres",
    "postgres-migrations",
    "postgres-schema",
    "postgresql",
    "postgresql-migrations",
    "row-level-security",
    "schema-diff",
    "schema-management",
    "supabase",
    "supabase-migrations",
    "typescript-types",
    "zod"
  ],
  "homepage": "https://supaschema.com/docs",
  "bugs": {
    "url": "https://github.com/jmclaughlin724/supaschema/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jmclaughlin724/supaschema.git"
  },
  "license": "AGPL-3.0-only",
  "author": "John McLaughlin",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "supaschema": "bin/supaschema.cjs"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "files": [
    ".agents/prompts/supaschema-install.md",
    ".agents/skills/supaschema",
    ".claude/hooks/guards/bash-policy-checks.mjs",
    ".claude/hooks/sync-llm-on-claude-surface-change.mjs",
    ".claude/rules/supaschema.md",
    ".claude/skills/supaschema",
    ".codex/hooks/general-guard.mjs",
    ".codex/hooks/guards/bash-policy-checks.mjs",
    ".codex/hooks/sync-llm-on-claude-surface-change.mjs",
    ".codex/hooks.json",
    ".codex/rules/supaschema.rules",
    "bin",
    "supaschema-config.schema.json",
    "dist",
    "LICENSE",
    "LICENSE-COMMERCIAL.md",
    "README.md"
  ],
  "scripts": {
    "bench:compare": "npm run build && node benchmarks/compare.js",
    "bench:plot": "node benchmarks/plot.js",
    "bench:plot:docs": "node benchmarks/plot.js benchmarks/results/comparison.json benchmarks/results/comparison-realistic.json benchmarks/results/comparison-xl.json benchmarks/results/comparison-xxl.json --charts-dir docs/images/benchmarks && npm run bench:plot:headtohead",
    "bench:plot:headtohead": "node benchmarks/plot-head-to-head.js --bars-only benchmarks/results/comparison-xl.json docs/images/benchmarks/head-to-head-xl-bars.svg && node benchmarks/plot-head-to-head.js benchmarks/results/comparison-xl.json docs/images/benchmarks/head-to-head-xl.svg && node benchmarks/plot-head-to-head.js benchmarks/results/comparison-xxl.json docs/images/benchmarks/head-to-head-xxl.svg && node benchmarks/plot-head-to-head.js --workflow benchmarks/results/comparison-xl.json docs/images/benchmarks/head-to-head-workflow-xl.svg",
    "bench:scan-aggregate": "npm run build && node benchmarks/tools/aggregate-scan-reports.mjs",
    "benchmark": "npm run build && node dist/benchmark.js",
    "build": "tsc -p tsconfig.src.json && node dist/config-schema-gen.js",
    "catalog:check": "node scripts/guards/check-dependency-catalog.mjs",
    "changeset": "changeset",
    "check": "npm run build && npm run lint && npm run typecheck && npm test",
    "check:package": "publint && attw --pack . --profile esm-only",
    "check:schema": "node scripts/check-schema.mjs",
    "corpus:check": "npm run build && node dist/cli.js corpus --corpus-dir corpus/supabase-style",
    "diagrams": "node benchmarks/plot-concepts.js",
    "docs:check": "npm run docs:lint && cd docs && npx --yes mint@4.2.616 validate && npx --yes mint@4.2.616 broken-links --check-anchors && npx --yes mint@4.2.616 a11y",
    "docs:dev": "cd docs && npx --yes mint@4.2.616 dev --no-open",
    "docs:lint": "node scripts/check-docs-standard.mjs",
    "fixture:diff": "node dist/cli.js diff --from dir:tests/fixtures/basic/from --to dir:tests/fixtures/basic/to --out stdout",
    "fixture:verify": "npm run build && out=$(mktemp -d)/basic.sql && node dist/cli.js diff --from dir:tests/fixtures/basic/from --to dir:tests/fixtures/basic/to --out \"$out\" && node dist/cli.js verify --from dir:tests/fixtures/basic/from --to dir:tests/fixtures/basic/to --migration \"$out\"",
    "format": "npm run format:json && ultracite fix . && npm run format:md && npm run format:toml && npm run format:sh",
    "format:json": "sort-package-json",
    "format:md": "prettier --write \"**/*.{md,mdx,yml,yaml}\"",
    "format:sh": "node scripts/format-sh.mjs",
    "format:toml": "node scripts/format-toml.mjs",
    "github:audit-settings": "node scripts/github/audit-settings.mjs",
    "github:check-dco": "node scripts/github/check-dco.mjs",
    "github:merge": "node scripts/github/merge.mjs",
    "github:merge-preflight": "node scripts/github/merge-preflight.mjs",
    "github:post-merge-verify": "node scripts/github/post-merge-verify.mjs",
    "github:pr-preflight": "node scripts/github/pr-preflight.mjs",
    "guard": "node scripts/guards/check-all.mjs",
    "guard:canonical-surfaces": "node scripts/guards/check-canonical-surfaces.mjs",
    "guard:catalog": "npm run catalog:check",
    "guard:ci": "node scripts/guards/check-ci-governance.mjs",
    "guard:github-process": "node scripts/guards/check-github-process.mjs",
    "guard:public-surface": "node scripts/guards/check-public-repo-surface.mjs",
    "guard:release-version": "node scripts/guards/check-release-version-surfaces.mjs",
    "lint": "ultracite check .",
    "lint:ci": "biome ci .",
    "lint:doctor": "ultracite doctor",
    "pack:dry": "npm pack --dry-run",
    "package:smoke": "node scripts/release/package-smoke.mjs",
    "release:notes": "node scripts/release/changelog-notes.mjs",
    "release:verify": "npm run guard:release-version && npm test -- tests/action.test.ts tests/release-preflight.test.ts && npm run build && npm run check:package && npm run package:smoke && npm run pack:dry && npm run guard",
    "release:version": "changeset version",
    "sync:llm": "node scripts/skills/sync-llm.mjs",
    "sync:llm:check": "node scripts/skills/sync-llm.mjs --check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:examples": "vitest run tests/examples.test.ts --maxWorkers=1",
    "test:matrix": "vitest run --exclude tests/examples.test.ts",
    "test:matrix:coverage": "vitest run --coverage --exclude tests/examples.test.ts",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.tools.json --noEmit"
  },
  "overrides": {
    "minimatch": "10.2.5",
    "read-yaml-file": "2.1.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "libpg-query": "^17.7.3",
    "pg": "^8.21.0",
    "pgsql-deparser": "^17.18.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@ast-grep/cli": "0.43.0",
    "@biomejs/biome": "2.5.0",
    "@changesets/cli": "^2.31.0",
    "@postgres-language-server/cli": "0.25.3",
    "@taplo/cli": "0.7.0",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.15.6",
    "@vitest/coverage-v8": "4.1.9",
    "bash-language-server": "5.6.0",
    "dockerfile-language-server-nodejs": "0.15.0",
    "fast-check": "^4.8.0",
    "lefthook": "^2.1.9",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.8.4",
    "publint": "^0.3.21",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "sh-syntax": "^0.5.8",
    "sort-package-json": "^4.0.0",
    "typescript": "^6.0.3",
    "typescript-language-server": "5.3.0",
    "ultracite": "7.8.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "4.1.9",
    "vscode-langservers-extracted": "4.10.0",
    "yaml": "^2.9.0",
    "yaml-language-server": "1.23.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
