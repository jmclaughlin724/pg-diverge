{
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/vitest"
  ],
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": true,
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!dist",
      "!node_modules",
      "!.venv",
      "!coverage",
      "!.tmp",
      "!**/.tmp",
      "!.wrangler",
      "!*.tgz",
      "!supaschema-config.schema.json",
      "!database.types.ts",
      "!database.zod.ts",
      "!api-docs",
      "!benchmarks/results",
      "!.gitnexus",
      "!.claude/worktrees",
      "!.claude/skills/code-review/references/workflow-backed-code-review.js",
      "!.claude/skills/deep-research/references/workflow-backed-deep-research.js",
      "!agent-bundle",
      "!**/*.astro",
      "!tests/fixtures/sample-project/supabase/functions",
      "!.agents",
      "!.codex"
    ]
  },
  "html": {
    "experimentalFullSupportEnabled": true
  },
  "javascript": {
    "experimentalEmbeddedSnippetsEnabled": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "options": {
            "extensionMappings": {
              "ts": "js",
              "tsx": "js"
            }
          }
        }
      },
      "performance": {
        "noAwaitInLoops": "off"
      },
      "style": {
        "useDestructuring": "off"
      },
      "suspicious": {
        "noMisplacedAssertion": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "services/license-worker/src/cloudflare-workers.d.ts",
        "services/license-worker/src/worker.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    }
  ]
}
