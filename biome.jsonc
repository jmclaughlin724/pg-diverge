{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "root": true,
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/type-aware",
    "ultracite/biome/vitest"
  ],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "!dist",
      "!node_modules",
      "!.venv",
      "!coverage",
      "!.tmp",
      "!.codeatlas",
      "!.codeatlas-sa",
      "!.wrangler",
      "!*.tgz",
      "!supaschema-config.schema.json",
      "!api-docs",
      "!benchmarks/results",
      "!.gitnexus",
      "!agent-bundle",
      "!tests/fixtures/sample-project/supabase/functions",
      "!.agents",
      "!.claude",
      ".claude/hooks/*.mjs",
      ".claude/rules/supaschema.md",
      ".claude/skills/supaschema/**",
      "!.codex",
      ".codex/hooks/*.mjs",
      ".codex/hooks.json",
      ".codex/rules/supaschema.rules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "options": {
            "extensionMappings": {
              "ts": "js",
              "tsx": "js"
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    }
  ]
}
