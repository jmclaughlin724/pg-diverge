{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-post-tool-use.mjs\"",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/context-post-tool-use.mjs\"",
            "statusMessage": "Recording supaschema hook evidence",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Read|Skill"
      },
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/supaschema-source-hook.mjs\" hook schema-write",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/supaschema-source-hook.mjs\" hook schema-write",
            "statusMessage": "Running supaschema auto-diff on schema change",
            "timeout": 130,
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-pre-tool-use.mjs\"",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/context-pre-tool-use.mjs\"",
            "statusMessage": "Checking required supaschema context",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Agent|Bash|Edit|Glob|Grep|MultiEdit|NotebookEdit|Read|Task|WebFetch|WebSearch|Write|apply_patch"
      },
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/supaschema-source-hook.mjs\" hook generated-artifact-edit --runtime codex",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/supaschema-source-hook.mjs\" hook generated-artifact-edit --runtime codex",
            "statusMessage": "Checking supaschema generated-artifact policy",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "apply_patch"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-session-start.mjs\"",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/context-session-start.mjs\"",
            "statusMessage": "Refreshing agent hook state",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-session-end.mjs\"",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/context-session-end.mjs\"",
            "statusMessage": "Clearing supaschema agent hook state",
            "timeout": 2,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-subagent-start.mjs\"",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/context-subagent-start.mjs\"",
            "statusMessage": "Loading supaschema subagent context",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-subagent-stop.mjs\"",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/context-subagent-stop.mjs\"",
            "statusMessage": "Checking supaschema subagent closeout",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-stop.mjs\"",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/context-stop.mjs\"",
            "statusMessage": "Checking supaschema final-response evidence",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/context-user-prompt-submit.mjs\"",
            "commandWindows": "for /f \"delims=\" %S in ('git rev-parse --show-toplevel') do @node \"%S/.codex/hooks/context-user-prompt-submit.mjs\"",
            "statusMessage": "Checking prompt-scoped supaschema context",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
