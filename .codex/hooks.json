{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/context-session-start.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading supaschema agent context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/context-user-prompt-submit.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking prompt-scoped supaschema context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/context-pre-tool-use.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking required supaschema context"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/supaschema-source-hook.mjs\" hook generated-migration-edit --runtime codex",
            "timeout": 10,
            "statusMessage": "Checking supaschema generated-migration policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/context-post-tool-use.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording supaschema hook evidence"
          }
        ]
      },
      {
        "matcher": "Bash|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/supaschema-source-hook.mjs\" hook schema-write",
            "timeout": 130,
            "statusMessage": "Running supaschema auto-diff on schema change"
          }
        ]
      },
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/sync-llm-on-claude-surface-change.mjs\"",
            "timeout": 130,
            "statusMessage": "Syncing supaschema Claude agent surfaces"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PROJECT_DIR:-$PWD}/.codex/hooks/context-subagent-start.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading supaschema subagent context"
          }
        ]
      }
    ]
  }
}
